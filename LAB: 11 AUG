void bubblesort( int a[], int n ){
    int i,j,temp ;
    for(i=0;i<=n-1;i++){
        for(j=0;j<=n-i-1;j++){
            if (a[j]>a[j+1]){
            temp= a[j];
            a[j]=a[j+1];
            a[j+1]=temp;
            }
        }
        printf("pass %d: ",i+1);
        printarray(a,n);
     }
}
int main(){
    int a[]={1,6,3,4,7,2};
    int n = sizeof(a)/sizeof(a[0]);
    bubblesort(a,n);
    printarray(a,n);
}

