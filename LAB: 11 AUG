void selectionsort(int a[],int n){
    int i,j,temp,min;
    for(i=0;i<=n-1;i++){
        min=i;
        for(j=i+1;j<n;j++){
            if(a[j]<a[min]){
             min=j;
            }
        }
        if(min != i){
         temp=a[i];
         a[i]=a[min];
         a[min]=temp;
        }
         printf("pass %d: ",i+1);
        printarray(a,n);
    }
}
  int main(){
    int a[]={10,55,65,5,15,25,35,20};
    int n = sizeof(a)/sizeof(a[0]);
    selectionsort(a,n);
    printarray(a,n);
  }


