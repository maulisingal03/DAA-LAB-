void printarray(int a[], int n){
    int i;
    for(i=0;i<n;i++)
        printf("%d ",a[i]);
    printf("\n");
}

void insertionsort(int a[], int n){
    int i,j,key;
    for(i=1;i<n;i++){
        key=a[i];
        j=i-1;
        while(j>=0 && a[j]>key){
            a[j+1]=a[j];
            j--;
        }
        a[j+1]=key;

        printf("pass %d: ",i);
        printarray(a,n);

    }
}
int main(){
    int a[]={4,5,6,7,3};
    int n=sizeof(a)/sizeof(a[0]);
    insertionsort(a,n);
    printarray(a,n);
}

